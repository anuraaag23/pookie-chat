# Copy to .env (in this same apps/backend/ directory — not the repo root)
# and fill in real values. Never commit .env.
#
# THIS LOCATION MATTERS: this file must live in apps/backend/, not the repo
# root. main.ts loads it via plain `dotenv/config` (defaults to reading
# .env from process.cwd(), which is apps/backend/ whenever this app is
# actually started — see main.ts's own comment for the full reasoning),
# and Prisma's CLI (prisma generate / prisma migrate dev) falls back to
# checking the current working directory too, which is the same
# apps/backend/ when run via `npm run prisma:generate --workspace=apps/backend`.
# A .env at the repo root is invisible to both.

NODE_ENV=development

PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/pookie_chat

# Generate real, random 32+ byte secrets per environment (e.g. `openssl rand -base64 32`).
# Never reuse the same secret across dev/staging/prod, and never commit real values.
# The server refuses to boot with either of these two literal placeholder
# strings, or with any secret under 20 characters — a hard failure in
# production, a startup warning elsewhere.
JWT_ACCESS_SECRET=replace-me-32-bytes-minimum
JWT_REFRESH_SECRET=replace-me-a-different-32-bytes-minimum

# HMAC pepper used to hash pairing codes server-side (docs/02-DATABASE-SCHEMA.md).
# Rotating this invalidates every currently-active pairing code — rotate deliberately.
# Same placeholder/length validation as the JWT secrets above applies here too.
PAIRING_CODE_PEPPER=replace-me-32-bytes-minimum

# ---- Email / SMTP (Stage 1 Authentication) ----
# When SMTP is not configured or in development, email codes are logged to the console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=replace-me-smtp-password
SMTP_FROM="Pookie Chat <no-reply@pookie.chat>"
SMTP_SECURE=false

# ---- User-Owned Google Drive Storage ----
# Google OAuth 2.0 Web Application credentials for user-owned Google Drive storage.
# Authorize redirect URI: http://localhost:4000/api/storage/google-drive/callback (or production URL)
# Scope requested: drive.file (only files created by Pookie Chat)
GOOGLE_DRIVE_CLIENT_ID=replace-me-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=replace-me-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/api/storage/google-drive/callback
# 32-byte hex/base64 key for encrypting OAuth tokens at rest with AES-256-GCM.
# If omitted in dev, derives from dev secret; mandatory in production.
GOOGLE_DRIVE_CREDENTIAL_KEY=replace-me-32-bytes-minimum

# ---- Legacy Shared Drive (Optional) ----
# Path to a GCP service-account JSON key for a dedicated Shared Drive. Never commit the key file.
# Relative paths here resolve from apps/backend/ (this file's own directory), same as everything else above.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
GOOGLE_DRIVE_SHARED_DRIVE_ID=replace-me
