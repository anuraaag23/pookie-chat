# Copy to .env.local (Next.js's own convention for a local, un-committed
# override — see https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables)
# in this same apps/web/ directory. Never commit .env.local.
#
# THIS LOCATION MATTERS: Next.js only ever reads .env files from its own
# app directory (apps/web/), never a monorepo root — a copy placed
# anywhere else is silently ignored, with no error.
#
# NEXT_PUBLIC_API_URL already defaults to this same value in code
# (next.config.js, lib/api/client.ts, lib/realtime/socket.ts) — creating
# this file is only necessary if your backend runs somewhere other than
# http://localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000
